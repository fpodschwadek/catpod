# Top-level Python dependencies of the CATPOD image.
#
# requirements.txt is generated from this file and pins every package,
# including dependencies, with hashes. Packages with compiled code
# (cryptography, cffi, pycparser, markupsafe, pyyaml) are left out: they are
# installed from Alpine's prebuilt py3-* packages instead (see Dockerfile), so
# no platform has to compile them. To regenerate requirements.txt after
# changing this file, run from the repository root:
#
#   docker run --rm -v "$PWD":/w -w /w alpine:3.24 sh -c \
#     "apk add -q py3-pip && pip install -q --break-system-packages pip-tools && \
#      pip-compile --generate-hashes --strip-extras \
#        --unsafe-package cryptography --unsafe-package cffi \
#        --unsafe-package pycparser --unsafe-package markupsafe \
#        --unsafe-package pyyaml \
#        --output-file=requirements.txt requirements.in"
ansible
docker
